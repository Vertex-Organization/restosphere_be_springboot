# Copy thanh .env roi dien gia tri. Tao secret bang: openssl rand -hex 32

# Database. Doi DB_PORT neu cong 5432 dang bi chiem (compose.yaml cung doc bien nay).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=restosphere
DB_USERNAME=restosphere
DB_PASSWORD=restosphere
JPA_DDL_AUTO=validate

JWT_SECRET=
JWT_ISSUER=restosphere
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# Tai khoan admin dau tien, chi duoc tao neu email chua ton tai.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Origin duoc phep goi API, cach nhau bang dau phay.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Bat sau khi dien thong tin tu Cloudinary Console > API Keys.
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# payOS: lay tu https://my.payos.vn > Kenh thanh toan. De trong thi khong tao duoc link thanh toan.
# Profile dev mac dinh dung link gia (PAYOS_FAKE=true); dat PAYOS_FAKE=false khi da co key that.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:5173/payment/result
PAYOS_CANCEL_URL=http://localhost:5173/payment/result?cancelled=true

MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
STAFF_LOGIN_URL=http://localhost:5173/staff/login
SWAGGER_ENABLED=false
FORWARD_HEADERS_STRATEGY=none
